# ---------------------------------------------------------------------
# Variables de entorno del Sistema de Asistencia QR (ISTPET)
#
# En LOCAL no hace falta ninguna: config/database.php ya trae los valores
# de XAMPP. En PRODUCCION se definen en el panel del proveedor
# (Railway: pestaña Variables; Render: Environment).
#
# Copia este archivo como .env solo si tu entorno lo lee; el codigo usa
# getenv(), asi que basta con definirlas en el panel del servidor.
# ---------------------------------------------------------------------

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=asistencia_qr
DB_USER=root
DB_PASS=

# --- Detras de un proxy con HTTPS (Railway, Render, Heroku, Nginx) ---
# Ponlo en 1 SOLO cuando haya un proxy de confianza delante.
# Sin esto, el sistema cree que la conexion es HTTP y se rompen los codigos
# QR, la geolocalizacion y la camara.
CONFIAR_EN_PROXY=1
